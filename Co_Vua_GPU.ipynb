   "source": [
    "## 🎯 Cell 3: Cấu hình & Training"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "\n",
    "# Thêm project vào path\n",
    "PROJECT_DIR = '/content/CoVua'\n",
    "sys.path.insert(0, PROJECT_DIR)\n",
    "\n",
    "# Cấu hình cho GPU T4 (16GB)\n",
    "ARGS = {\n",
    "    'num_iters': 1000,        # Số iterations\n",
    "    'num_eps': 25,            # Số episodes/self-play mỗi iteration\n",
    "    'max_len': 100,          # Độ dài tối đa của một game\n",
    "    'num_channels': 256,      # Số channels (GPU mạnh có thể tăng)\n",
    "    'num_res_blocks': 5,      # Số residual blocks\n",
    "    'lr': 0.001,             # Learning rate\n",
    "    'epochs': 5,             # Số epochs train mỗi iteration\n",
    "    'batch_size': 64,        # Batch size\n",
    "    'cuda': True,            # Sử dụng GPU\n",
    "    'num_mcts_sims': 50,     # Số MCTS simulations\n",
    "    'cpuct': 1.5,            # MCTS exploration factor\n",
    "    'checkpoint': f'{PROJECT_DIR}/checkpoints',\n",
    "    'log_dir': f'{PROJECT_DIR}/logs',\n",
    "    'save_every': 5,        # Lưu checkpoint mỗi X episodes\n",
    "    'train_every': 1,        # Train sau mỗi X episodes\n",
    "    'auto_save_minutes': 5,  # Auto-save mỗi 5 phút\n",
    "    'upload_drive': True,    # Upload checkpoint lên Google Drive\n",
    "    'drive_folder': '/content/drive/MyDrive/CoVua_Checkpoints',\n",
    "    'load_model': True,      # Load checkpoint cũ nếu có\n",
    "    'workers': 2\n",
    "}\n",
    "\n",
    "# Tạo thư mục\n",
    "os.makedirs(f'{PROJECT_DIR}/checkpoints', exist_ok=True)\n",
    "os.makedirs(f'{PROJECT_DIR}/logs', exist_ok=True)\n",
    "os.makedirs(ARGS['drive_folder'], exist_ok=True)\n",
    "\n",
    "print(\"🎯 Cấu hình Training:\")\n",
    "for k, v in ARGS.items():\n",
    "    print(f\"  {k}: {v}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# BẮT ĐẦU TRAINING 🚀\n",
    "print(\"=\" * 60)\n",
    "print(\"🎮 BẮT ĐẦU TRAINING ALPHAZERO CỜ VUA - GPU T4\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "# Fix lỗi Colab - clear argv trước khi import\n",
    "sys.argv = ['']\n",
    "\n",
    "# Import và chạy\n",
    "from utils import dotdict\n",
    "import train\n",
    "\n",
    "# Gán args\n",
    "args = dotdict(ARGS)\n",
    "train.args = args\n",
    "\n",
    "# Chạy training\n",
    "train.main()"
   ]
